# Clawith Backend 连接信息
BACKEND_HTTP_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000

# 登录凭证（用于自动获取/刷新 backend JWT，token 24 小时过期，会自动重新登录）
BACKEND_EMAIL=
BACKEND_PASSWORD=

# 可选：当该账号关联多个租户时，登录接口会要求选择租户（无法在无人值守场景里手动选择）。
# 填写目标租户的名称（对应后台显示的租户名 tenant_name，或它的 slug 都可以），
# 服务会自动在候选列表里匹配并据此完成登录。只关联单个租户的账号不需要填这项。
BACKEND_TENANT_NAME=

# MCP 服务端监听配置
MCP_HOST=0.0.0.0
MCP_PORT=4008

# 远程/本地 MCP 客户端连接时需要携带的密钥（请求头 Authorization: Bearer <值>）
# 请更换为你自己的随机字符串（切勿直接使用此占位值）
MCP_API_KEY=uc_mcp_change_me
